# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_URL=jdbc:mysql://localhost:3306/expense_tracker?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Generate a secure base64 encoded JWT secret key (min 32 characters)
# You can generate one with: echo -n "your-secret-key-min-32-chars" | base64
JWT_SECRET=your_jwt_secret_key_here_base64_encoded_change_in_production

# ==========================================
# EMAIL CONFIGURATION (Gmail)
# ==========================================
# Gmail SMTP Configuration
# IMPORTANT: Use Gmail App Password, NOT your regular Gmail password!
# To generate an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to App passwords (select Mail and Windows Computer/Other)
# 4. Copy the 16-character password and paste it below
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Email sender details
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=Expense Tracker

# ==========================================
# PASSWORD RESET CONFIGURATION
# ==========================================
# Token expiration time in minutes
PASSWORD_RESET_EXPIRATION=30

# Frontend URL for password reset link
# Frontend should have a page at /reset-password?token=<token>
APP_FRONTEND_URL=http://localhost:8080

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================
# Directory to store uploaded files (local filesystem)
UPLOAD_DIR=./uploads

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# SERVER_PORT=8080

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
# LOG_LEVEL=INFO

